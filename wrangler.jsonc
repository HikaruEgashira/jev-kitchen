{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-kitchen",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "build": {
    "command": "pnpm build",
    "watch_dir": "src",
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "ai": {
    "binding": "AI",
  },
  "ratelimits": [
    {
      "name": "SESSION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "DECIDE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 240, "period": 60 },
    },
  ],
}
