{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-kitchen",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "build": {
    "command": "pnpm build",
    "watch_dir": "src",
  },
  "assets": {
    "directory": "./dist",
  },
  "ai": {
    "binding": "AI",
  },
}
